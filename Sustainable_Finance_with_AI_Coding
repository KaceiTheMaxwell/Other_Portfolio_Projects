# 4. GEMINI BRIEF GENERATION (COMPLETE 4 SECTIONS)
# ===========================================================================
def generate_engagement_brief(screening_data):
    client = genai.Client()
    selected_model = "gemini-3.8-flash"

    prompt = f"""
    You are an expert ESG & Climate Analyst for an institutional investor. 
    Below is the multi-year screening analysis (2020-2025 reports) comparing Ithaca Energy plc against official IFRS S2 and TCFD standards:

    {json.dumps(screening_data, indent=2)}

    Task:
    Generate a concise, complete 1-page structured Engagement Brief in Markdown. Be direct, clear, and ensure you complete ALL 4 sections in their entirety without getting cut off:

    1. EXECUTIVE SUMMARY & MULTI-YEAR COMPLIANCE SCORECARD (2020-2025 Evaluation)
    2. KEY DISCLOSURE GAPS (Summary of Scope 3, Scenario Analysis, Financial Effects, and Governance gaps under IFRS S2)
    3. RECOMMENDED INVESTOR ENGAGEMENT QUESTIONS (5 targeted questions for management)
    4. ACTIONABLE STEPS FOR ITHACA ENERGY TO ALIGN FULLY WITH IFRS S2
    """

    response = client.models.generate_content(
        model=selected_model,
        contents=prompt,
        config=types.GenerateContentConfig(
            temperature=0.2,
            max_output_tokens=2500
        )
    )

    return response.text

print("\n--- GENERATING GEMINI ENGAGEMENT BRIEF ---")
engagement_brief_md = generate_engagement_brief(screening_df.to_dict(orient="records"))


